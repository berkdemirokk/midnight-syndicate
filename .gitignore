# Godot
game/.godot/
game/*.translation
game/export/
*.import.bak
# Blender
*.blend1
*.blend2
# Python
__pycache__/
*.pyc
.venv/
# Logs and scratch
*.log
evidence/tmp/
assets_src/**/attempt_*/out/*.blend
# OS
Thumbs.db
.DS_Store
# Secrets and signing: never commit
*.p12
*.mobileprovision
*.cer
*.p8
*.keystore
.env
export_credentials.cfg
# Third-party CC0 downloads are reproducible via tools/fetch_cc0.py (pinned ids); only the
# processed copies under game/assets are committed.
assets_src/textures/cc0/
assets_src/**/out/*.blend
assets_src/**/*.blend1
# Rejected car attempts (judge panel round 1) stay local
assets_src/vehicles/noctra_sable/attempt_*/
evidence/tmp/

# Agent worktrees (local only)
.claude/worktrees/

# AI concept image supplied by the owner: reference only, never shipped or published
MIDNIGHT_RESCUE/reference/
asset_inbox/
# Raw CC0 audio downloads (archives, extracted packs, source wav/mp3): reproducible from source.json; only game/assets/audio/cc0 is committed
assets_src/third_party/audio_cc0/**/*.zip
assets_src/third_party/audio_cc0/**/extracted/
assets_src/third_party/audio_cc0/**/*.wav
assets_src/third_party/audio_cc0/**/*.mp3
# Raw CC0 audio downloads (any format): reproducible from source.json; only game/assets/audio/cc0 is committed
assets_src/third_party/audio_cc0/**/*.ogg
