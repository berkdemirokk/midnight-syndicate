extends SceneTree
## Headless test runner. Owned by the lead; add tests as tests/test_*.gd, do not edit this file.
## godot --headless --fixed-fps 60 --path game -s res://tests/run_tests.gd -- [--only=test_a,test_b]
## Exit code 0 = all passed. Results: <repo>/evidence/test_results.json (merged per test file).


## Counts script runtime errors. A coroutine that hits one simply returns, so without this a
## crashed test would be reported as passed.
class ErrLogger extends Logger:
	var script_errors: int = 0
	var last: String = ""

	func _log_error(function: String, file: String, line: int, code: String, rationale: String, _editor_notify: bool, error_type: int, _script_backtraces: Array[ScriptBacktrace]) -> void:
		if error_type == Logger.ERROR_TYPE_SCRIPT:
			script_errors += 1
			last = "%s:%d in %s: %s %s" % [file, line, function, code, rationale]


var _err := ErrLogger.new()


func _initialize() -> void:
	OS.add_logger(_err)
	_run.call_deferred()


func _run() -> void:
	var only := PackedStringArray()
	for a: String in OS.get_cmdline_user_args():
		if a.begins_with("--only="):
			only = a.trim_prefix("--only=").split(",")
	var files: Array[String] = []
	for f: String in DirAccess.get_files_at("res://tests"):
		if f.begins_with("test_") and f.ends_with(".gd") and f != "test_case.gd":
			if only.is_empty() or only.has(f.get_basename()):
				files.append(f)
	files.sort()

	var out_path: String = ProjectSettings.globalize_path("res://").path_join("../evidence/test_results.json").simplify_path()
	var results: Dictionary = {}
	# A full run rebuilds the file; a partial run (--only) merges into it.
	if not only.is_empty() and FileAccess.file_exists(out_path):
		var prev: Variant = JSON.parse_string(FileAccess.get_file_as_string(out_path))
		if prev is Dictionary:
			results = prev

	var total := 0
	var failed := 0
	for f: String in files:
		var script: GDScript = load("res://tests/" + f)
		if script == null or not script.can_instantiate():
			print("[ERROR] %s does not load" % f)
			failed += 1
			total += 1
			results[f] = {"error": "script does not load"}
			continue
		var file_result: Dictionary = {}
		for m: Dictionary in script.get_script_method_list():
			var mname: String = m["name"]
			if not mname.begins_with("test_"):
				continue
			var t: Object = script.new()
			t.tree = self
			total += 1
			var errors_before: int = _err.script_errors
			var root_before: Array[Node] = root.get_children()
			await t.call(mname)
			var fails: Array = t.failures
			if _err.script_errors > errors_before:
				fails.append("script error during the test: " + _err.last)
			# Isolation: a test that crashed before its cleanup must not leave a scene for the next one.
			var leaked := 0
			for n: Node in root.get_children():
				if not root_before.has(n):
					leaked += 1
					n.queue_free()
			if leaked > 0:
				await physics_frame
				fails.append("left %d node(s) in the tree (freed by the runner)" % leaked)
			if paused:
				paused = false
				fails.append("left the tree paused")
			if fails.is_empty():
				print("[PASS] %s::%s %s" % [f, mname, JSON.stringify(t.metrics)])
			else:
				failed += 1
				print("[FAIL] %s::%s" % [f, mname])
				for msg: String in fails:
					print("       - " + msg)
			file_result[mname] = {"pass": fails.is_empty(), "failures": fails, "metrics": t.metrics}
		results[f] = file_result

	results["_meta"] = {
		"godot": Engine.get_version_info()["string"],
		"time": Time.get_datetime_string_from_system(),
		"physics_engine": ProjectSettings.get_setting("physics/3d/physics_engine", "DEFAULT"),
	}
	DirAccess.make_dir_recursive_absolute(out_path.get_base_dir())
	var fa := FileAccess.open(out_path, FileAccess.WRITE)
	if fa:
		fa.store_string(JSON.stringify(results, "  "))
		fa.close()
	print("== %d tests, %d failed ==" % [total, failed])
	quit(1 if failed > 0 else 0)
